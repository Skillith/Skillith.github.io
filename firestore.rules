rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio_demo_requests/{docId} {
      allow create: if request.resource.data.email is string && request.resource.data.name is string;
      allow read, update, delete: if false;
    }
    match /public_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
